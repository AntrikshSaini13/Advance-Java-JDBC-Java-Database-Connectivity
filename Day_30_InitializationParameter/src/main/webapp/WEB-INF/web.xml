<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee"  id="WebApp_ID" version="6.0">
  <display-name>Day_30_InitializationParameter</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
  </welcome-file-list>
  <servlet>
    <description></description>
    <display-name>LoginOnServer</display-name>
    <servlet-name>LoginOnServer</servlet-name>
    <servlet-class>registration.LoginOnServer</servlet-class>
    <init-param>
      <param-name>DRIVER</param-name>
      <param-value>oracle.jdbc.driver.OracleDriver</param-value>
    </init-param>
    <init-param>
      <param-name>URL</param-name>
      <param-value>jdbc:oracle:thin:@localhost:1521:ORCL</param-value>
    </init-param>
    <init-param>
      <param-name>USERNAME</param-name>
      <param-value>MYDB11AM</param-value>
    </init-param>
    <init-param>
      <param-name>PASSWORD</param-name>
      <param-value>123</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginOnServer</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>RegistrationOnServer</display-name>
    <servlet-name>RegistrationOnServer</servlet-name>
    <servlet-class>registration.RegistrationOnServer</servlet-class>
    <init-param>
      <param-name>DRIVER</param-name>
      <param-value>oracle.jdbc.driver.OracleDriver</param-value>
    </init-param>
    <init-param>
      <param-name>URL</param-name>
      <param-value>jdbc:oracle:thin:@localhost:1521:ORCL</param-value>
    </init-param>
    <init-param>
      <param-name>USERNAME</param-name>
      <param-value>MYDB11AM</param-value>
    </init-param>
    <init-param>
      <param-name>PASSWORD</param-name>
      <param-value>123</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>RegistrationOnServer</servlet-name>
    <url-pattern>/registration</url-pattern>
  </servlet-mapping>
</web-app>